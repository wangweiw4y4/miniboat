        dual_beacon_link_miniboat8:
          Value: false
        imu_link_miniboat8:
          Value: false
      Marker Scale: 1
      Name: TF
      Show Arrows: false
      Show Axes: true
      Show Names: false
      Tree:
        {}
      Update Interval: 0
      Value: false
    - Class: rviz/Group
      Name: Miniboat4
      Enabled: false
      Displays:
      - Class: rviz/Marker
        Enabled: true
        Marker Topic: /miniboat4/visual/robot
        Name: Miniboat4
        Namespaces:
          miniboat6: true
        Queue Size: 100
        Value: true
      - Name: Trajectory4
        Class: rviz/Path
        Enabled: true
        Topic: /miniboat4/visual/path
