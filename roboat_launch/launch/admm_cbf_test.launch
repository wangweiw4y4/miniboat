<launch>
 
    <!-- boat id
         - remember to add 'export HOSTNAME' to the .bashrc file or script launching the program 
         - namespaces with '-' character are not valid, need to be changed
    -->
    <arg    name="id"                   default="$(env HOSTNAME)"/>
    <arg    name="use_multimaster"      default="true"/>
    <arg    name="use_ekf"              default="true"/>

    <!-- Multimaster synchronization -->
    <node if="$(arg use_multimaster)" name="master_discovery"  pkg="fkie_master_discovery"   type="master_discovery"    output="screen">
        <param name="mcast_group" type="str" value="224.0.0.1" />
    </node>
    <node if="$(arg use_multimaster)" name="master_sync"  pkg="fkie_master_sync"   type="master_sync"    output="screen">
        <!--rosparam param="ignore_topics">['/tf']</rosparam-->
        <!--rosparam param="ignore_nodes">['/miniboat1/hedge_rcv_bin','/miniboat2/hedge_rcv_bin','/miniboat3/hedge_rcv_bin','/miniboat4/hedge_rcv_bin','/miniboat5/hedge_rcv_bin','/miniboat6/hedge_rcv_bin','/miniboat7/hedge_rcv_bin','/miniboat8/hedge_rcv_bin','/miniboat1/ros_imu_bno055_node','/miniboat2/ros_imu_bno055_node','/miniboat3/ros_imu_bno055_node','/miniboat4/ros_imu_bno055_node','/miniboat5/ros_imu_bno055_node','/miniboat6/ros_imu_bno055_node','/miniboat7/ros_imu_bno055_node','/miniboat8/ros_imu_bno055_node','/miniboat1/velocity_cascade_pid','/miniboat2/velocity_cascade_pid','/miniboat3/velocity_cascade_pid','/miniboat4/velocity_cascade_pid','/miniboat5/velocity_cascade_pid','/miniboat6/velocity_cascade_pid','/miniboat7/velocity_cascade_pid','/miniboat8/velocity_cascade_pid']</rosparam-->
        <!--rosparam param="sync_topics">['/tf','/tf_static','/shape','/$(arg id)/odometry/filtered','/$(arg id)/assignment/reference_pose','/$(arg id)/joy','/$(arg id)/shrink_flag','/$(arg id)/visual/shape',]</rosparam-->
        <!--rosparam param="sync_topics">['/tf','/tf_static','/shape','/miniboat1/shrink_flag','/miniboat1/odometry/filtered','/miniboat2/odometry/filtered','/miniboat3/odometry/filtered','/miniboat4/odometry/filtered','/miniboat5/odometry/filtered','/miniboat6/odometry/filtered','/miniboat7/odometry/filtered','/miniboat8/odometry/filtered','/miniboat1/assignment/reference_pose','/miniboat2/assignment/reference_pose','/miniboat3/assignment/reference_pose','/miniboat4/assignment/reference_pose','/miniboat5/assignment/reference_pose','/miniboat6/assignment/reference_pose','/miniboat7/assignment/reference_pose','/miniboat8/assignment/reference_pose','/miniboat1/joy','/miniboat2/joy','/miniboat3/joy','/miniboat4/joy','/miniboat5/joy','/miniboat6/joy','/miniboat7/joy','/miniboat8/joy']</rosparam-->
        <rosparam param="sync_topics">['/tf','/tf_static', '/counter_restart',
            '/miniboat1/boat_state','/miniboat2/boat_state','/miniboat3/boat_state','/miniboat4/boat_state',
            '/miniboat5/boat_state','/miniboat6/boat_state','/miniboat7/boat_state','/miniboat8/boat_state',
            '/miniboat1/assignment/reference_pose','/miniboat2/assignment/reference_pose','/miniboat3/assignment/reference_pose',
            '/miniboat4/assignment/reference_pose','/miniboat5/assignment/reference_pose','/miniboat6/assignment/reference_pose',
            '/miniboat7/assignment/reference_pose','/miniboat8/assignment/reference_pose',
            '/miniboat1/joy','/miniboat2/joy','/miniboat3/joy','/miniboat4/joy',
            '/miniboat5/joy','/miniboat6/joy','/miniboat7/joy','/miniboat8/joy',
            '/miniboat1/latching','/miniboat2/latching','/miniboat3/latching','/miniboat4/latching',
            '/miniboat5/latching','/miniboat6/latching','/miniboat7/latching','/miniboat8/latching',
            '/miniboat1/ocpX_time','/miniboat2/ocpX_time','/miniboat3/ocpX_time','/miniboat4/ocpX_time',
            '/miniboat5/ocpX_time','/miniboat6/ocpX_time','/miniboat7/ocpX_time','/miniboat8/ocpX_time',
            '/miniboat1/ocpZ_time','/miniboat2/ocpZ_time','/miniboat3/ocpZ_time','/miniboat4/ocpZ_time',
            '/miniboat5/ocpZ_time','/miniboat6/ocpZ_time','/miniboat7/ocpZ_time','/miniboat8/ocpZ_time',
            '/miniboat1/cbf_time','/miniboat2/cbf_time','/miniboat3/cbf_time','/miniboat4/cbf_time',
            '/miniboat5/cbf_time','/miniboat6/cbf_time','/miniboat7/cbf_time','/miniboat8/cbf_time',
            '/miniboat1/velocity_reference','/miniboat2/velocity_reference','/miniboat3/velocity_reference','/miniboat4/velocity_reference',
            '/miniboat5/velocity_reference','/miniboat6/velocity_reference','/miniboat7/velocity_reference','/miniboat8/velocity_reference',            
            '/miniboat1/trajectory','/miniboat2/trajectory','/miniboat3/trajectory','/miniboat4/trajectory',
            '/miniboat5/trajectory','/miniboat6/trajectory','/miniboat7/trajectory','/miniboat8/trajectory',
            '/miniboat1/local_copies','/miniboat2/local_copies','/miniboat3/local_copies','/miniboat4/local_copies',
            '/miniboat5/local_copies','/miniboat6/local_copies','/miniboat7/local_copies','/miniboat8/local_copies',
            '/miniboat1/lambda_multipliers','/miniboat2/lambda_multipliers','/miniboat3/lambda_multipliers','/miniboat4/lambda_multipliers',
            '/miniboat5/lambda_multipliers','/miniboat6/lambda_multipliers','/miniboat7/lambda_multipliers','/miniboat8/lambda_multipliers'
            ]</rosparam>
    </node>
    <!-- package namespace -->
    <group ns="$(arg id)">

        <param  name="roboat_id"    type="string"   value="$(arg id)" />

        <include file="$(find roboat_core)/launch/master.launch">
            <arg name="sim_node"            value="false"/>
            <arg name="serial_node"         value="true"/>
            <arg name="csv_path_node"       value="false"/>
            <arg name="mpc_node"            value="false"/>
            <arg name="pf_node"             value="false"/>
            <arg name="command_node"        value="true"/>
            <arg name="joy_node"            value="false"/>
            <arg name="pid_node"            value="false"/>
            <arg name="state_node"          value="true"/>
            <arg name="swarm_node"          value="false"/>
            <arg name="bag_node"            value="false"/>
            <arg name="capacitive_node"     value="false"/>
        </include>
        
        <include file="$(find ros_imu_bno055)/launch/imu.launch">
            <arg name = "serial_port" value="/dev/ttyUSB0" />
            <arg name = "frame_id" value="imu_link" />
            <arg name = "operation_mode" value="NDOF_FMC_OFF"/>
            <arg name = "oscillator" value="INTERNAL" />
            <arg name = "reset_orientation" value="true" />
            <arg name = "frequency" value="100" /> 
            <arg name = "use_magnetometer" value="true" />
            <arg name = "use_temperature" value="true" /> 
        </include>
        
        <!-- paired beacons; arguments are "serial port & baudrate" -->
        <node pkg="marvelmind_nav" type="hedge_rcv_bin" name="hedge_rcv_bin" args="/dev/ttyACM0 500000" output="screen"/>
        
        <!-- Run the serial node for the capacitive sensors-->
    <!--    <node pkg="rosserial_python" type="serial_node.py" name="cap_serial_node"  respawn="true">
        <param name="port" value="/dev/ttyACM0"/>
        <param name="baud" value="57600"/>
        </node>        
    -->    
        

        <!--include file="$(find pid)/launch/headingpid.launch">
        </include-->

        <include file="$(find roboat_localization)/launch/localization.launch" >
            <arg name="id"                  value="$(arg id)"/>
            <arg name="use_ekf"             value="$(arg use_ekf)"/>
        </include>

        <include file="$(find roboat_core)/launch/velocity_cascade_pid.launch">
        </include>

        <!--include file="$(find roboat_core)/launch/pf_vel_8.launch">
        </include-->

        <node pkg="roboat_core" type="miniboat_admm_cbf" name="miniboat_admm_cbf"/>        
        
    </group>
     
</launch>
