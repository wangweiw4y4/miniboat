void matrixMultiply(double C[6][6], double A[6][6], double B[6][6]){

    for(int m=0; m<6; m++)
    {
      for(int s=0; s<6; s++)
      {
        C[m][s]=0;//变量使用前记得初始化，否则结果具有不确定性
        for(int n=0; n<6; n++)
        {
          C[m][s]+=A[m][n]*B[n][s];
        }
      }
    }
}

