std::vector<float> stateCalc(float GPSData[], float IMUData[])
{
    //state[0-5]:x,y,psai,u,v,r
    std::vector<float> state(6);

    state[0] = GPSData[1]/1000;
    state[1] = GPSData[2]/1000;

    float xdot = (state[0] - lastX)/SAMPLE_T;
    float ydot = (state[1] - lastY)/SAMPLE_T;
    if (xdot>0.2)
    xdot=0.2;
    if (xdot<-0.2)
    xdot=-0.2;
    if (ydot>0.2)
    ydot=0.2;
    if (ydot<-0.2)
    ydot=-0.2;
    if(firstposflag==0)
    {
      xdot=0;
      ydot=0;
      firstposflag=1;
    }

    state[2] = M_PI/180*(IMUData[2] - ANGLE_DRIFT);
    if(state[2] < -M_PI){
        state[2] += 2*M_PI;
    }
    if(state[2] > M_PI){
        state[2] -= 2*M_PI;
    }

    state[3] = cos(state[2])*xdot + sin(state[2])*ydot;
    state[4] = -sin(state[2])*xdot + cos(state[2])*ydot;
    state[5] = AngularVelocityDirection*IMUData[5]*M_PI/180;

    lastX = state[0];
    lastY = state[1];

    return state;
}

