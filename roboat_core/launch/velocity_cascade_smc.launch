<launch>

    <node name="velocity_cascade_smc" pkg="roboat_core" type="velocity_cascade_smc" >
	<param name = "k1_u" value = "0.3" />
	<param name = "k2_u" value = "0.1" />
	<param name = "lambda_u" value = "0.001" />
	<param name = "k1_v" value = "0.3" />
	<param name = "k2_v" value = "0.1" />
	<param name = "lambda_v" value = "0.001" />
	<param name = "k1_r" value = "0.2" />
	<param name = "k2_r" value = "0.005" />
	<param name = "lambda_r" value = "0.0001" />
	<param name = "p_psi" value = "0.05" />
	<param name = "i_psi" value = "0.00" />
	<param name = "d_psi" value = "0.001" />
    </node>

</launch>