<launch>

    <node name="pf_vel_node" pkg="roboat_core" type="pf_vel_node" >
	<param name = "target_region" value = "1.2" />
	<param name = "target_r0" value = "0.4" />
	<param name = "target_stf" value = "0.01" />
	<param name = "target_srf" value = "400.0" />
	<param name = "multi_region" value = "2.0" />
	<param name = "multi_r0" value = "2.0" />
	<param name = "multi_stf" value = "0.00001" />
	<param name = "multi_srf" value = "0.0001" />
	<param name = "shrink_time" value = "30" />
	<param name = "inside_time" value = "30" />
	<param name = "x_center" value = "2.0" />
	<param name = "y_center" value = "1.5" />
	<param name = "attractive_par_1" value = "0.1" />
	<param name = "attractive_par_2" value = "0.5" />
	<param name = "neighbour_radius" value = "1.0" />
    </node>

</launch>