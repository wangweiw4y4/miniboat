<launch>

    <node name="velocity_pid" pkg="roboat_core" type="velocity_pid" >
	<param name = "p_u" value = "0.8" />
	<param name = "i_u" value = "0.4" />
	<param name = "d_u" value = "0.4" />
	<param name = "p_v" value = "0.8" />
	<param name = "i_v" value = "0.4" />
	<param name = "d_v" value = "0.4" />
	<param name = "p_psi" value = "0.00075" />
	<param name = "i_psi" value = "0.0" />
	<param name = "d_psi" value = "0.0015" />
    </node>

</launch>