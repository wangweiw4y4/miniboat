<launch>

    <node name="velocity_cascade_pid" pkg="roboat_core" type="velocity_cascade_pid" >
	<param name = "p_u" value = "0.4" />
	<param name = "i_u" value = "0.2" />
	<param name = "d_u" value = "0.2" />
	<param name = "p_v" value = "0.4" />
	<param name = "i_v" value = "0.2" />
	<param name = "d_v" value = "0.2" />
	<param name = "p_r" value = "0.4" />
	<param name = "i_r" value = "0.2" />
	<param name = "d_r" value = "0.2" />
	<param name = "p_psi" value = "0.002" />
	<param name = "i_psi" value = "0.0" />
	<param name = "d_psi" value = "0.004" />
    </node>

</launch>